{{ 'section-article-with-sidebar.css' | asset_url | stylesheet_tag }}

<section class="as-section" data-section-id="{{ section.id }}">
  <div class="as-container">

    {%- comment -%} ===== MAIN CONTENT (LEFT) ===== {%- endcomment -%}
    <article class="as-main">

      <h1 class="as-title">{{ section.settings.title }}</h1>

      {% if section.settings.date != blank %}
        <p class="as-date">{{ section.settings.date }}</p>
      {% endif %}

      {% if section.settings.body_text != blank %}
        <div class="as-body rte">{{ section.settings.body_text }}</div>
      {% endif %}

      {%- comment -%} Quote block -----{%- endcomment -%}
      {% if section.settings.quote_text != blank %}
        <blockquote class="as-quote">
          <p>{{ section.settings.quote_text }}</p>
          {% if section.settings.quote_author != blank %}
            <cite>— {{ section.settings.quote_author }}</cite>
          {% endif %}
        </blockquote>
      {% endif %}

      {%- comment -%} Before / After -----{%- endcomment -%}
      {% if section.settings.before_image != blank or section.settings.after_image != blank %}
        <div class="as-ba">
          {% if section.settings.before_image != blank %}
            <div class="as-ba__item">
              <img
                src="{{ section.settings.before_image | image_url: width: 600 }}"
                alt="{{ section.settings.before_image.alt | default: section.settings.before_label }}"
                loading="lazy"
                width="600"
                height="600"
              >
              <span class="as-ba__label">{{ section.settings.before_label }}</span>
            </div>
          {% endif %}
          {% if section.settings.after_image != blank %}
            <div class="as-ba__item">
              <img
                src="{{ section.settings.after_image | image_url: width: 600 }}"
                alt="{{ section.settings.after_image.alt | default: section.settings.after_label }}"
                loading="lazy"
                width="600"
                height="600"
              >
              <span class="as-ba__label">{{ section.settings.after_label }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} Extra content blocks -----{%- endcomment -%}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <div class="as-block-text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% when 'image' %}
            <div class="as-block-image" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.image.alt | default: '' }}"
                loading="lazy"
                width="1000"
              >
            </div>
        {% endcase %}
      {% endfor %}
    </article>

    {%- comment -%} ===== SIDEBAR (RIGHT) ===== {%- endcomment -%}
    <aside class="as-sidebar">
      <div class="as-card">

        {% if section.settings.sidebar_heading != blank %}
          <h2 class="as-card__heading">{{ section.settings.sidebar_heading }}</h2>
        {% endif %}

        {% if section.settings.sidebar_image != blank %}
          <div class="as-card__image">
            <img
              src="{{ section.settings.sidebar_image | image_url: width: 500 }}"
              alt="{{ section.settings.sidebar_image.alt | default: section.settings.sidebar_heading }}"
              loading="lazy"
              width="500"
            >
          </div>
        {% endif %}

        {% if section.settings.sidebar_text != blank %}
          <p class="as-card__text">{{ section.settings.sidebar_text }}</p>
        {% endif %}

        {% if section.settings.sidebar_button_label != blank %}
          <a
            href="{{ section.settings.sidebar_button_link | default: '#' }}"
            class="as-card__btn"
          >
            {{ section.settings.sidebar_button_label }} ›
          </a>
        {% endif %}
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Article + Sidebar",
  "tag": "section",
  "class": "as-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Contenu principal"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre",
      "default": "Dermatologist: '19 Years of Training Didn't Teach Me How to Reverse Crepey Arms. 30 Minutes in Paris Did'"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date",
      "default": "December 17, 2025 at 8:42 am EST"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Texte principal"
    },
    {
      "type": "header",
      "content": "Citation / Témoignage"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Texte de la citation",
      "default": "By the time you notice the damage, the optimal reversal window is already half-closed. This is the most preventable tragedy I see in my practice every single week."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Auteur de la citation",
      "default": "Anne Beaumont, Clinical Aesthetician"
    },
    {
      "type": "header",
      "content": "Images Avant / Après"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Image Avant"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Label Avant",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Image Après"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "Label Après",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Sidebar — Produit"
    },
    {
      "type": "textarea",
      "id": "sidebar_heading",
      "label": "Titre sidebar",
      "default": "Give Your Skin Its Last Chance At Full Recovery"
    },
    {
      "type": "image_picker",
      "id": "sidebar_image",
      "label": "Image produit"
    },
    {
      "type": "textarea",
      "id": "sidebar_text",
      "label": "Description",
      "default": "Get the #1 Aesthetician-Recommended Solution For Reversing Sudden Hormonal Skin Collapse"
    },
    {
      "type": "text",
      "id": "sidebar_button_label",
      "label": "Texte du bouton",
      "default": "CHECK AVAILABILITY"
    },
    {
      "type": "url",
      "id": "sidebar_button_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Bloc texte",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    },
    {
      "type": "image",
      "name": "Bloc image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article + Sidebar"
    }
  ]
}
{% endschema %}
